FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY index.html tsconfig.json vite.config.ts ./
COPY shared ./shared
COPY src ./src

RUN npm run build

FROM nginx:1.27-alpine

# openssl: o entrypoint gera a CA local e o certificado HTTPS do painel na primeira subida
RUN apk add --no-cache openssl \
  && rm -f /etc/nginx/conf.d/default.conf

# O nginx da imagem processa /etc/nginx/templates/*.template (substitui ${HTTPS_PUBLIC_PORT})
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
# Scripts de /docker-entrypoint.d rodam em ordem: este gera os certificados antes do nginx iniciar
COPY docker/25-fwaudit-tls.sh /docker-entrypoint.d/25-fwaudit-tls.sh
RUN chmod +x /docker-entrypoint.d/25-fwaudit-tls.sh \
  && mkdir -p /etc/nginx/certs

COPY --from=builder /app/dist /usr/share/nginx/html

ENV HTTPS_PUBLIC_PORT=8443

EXPOSE 80 443

# A porta 80 só redireciona; /healthz responde sem depender do certificado
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:80/healthz || exit 1
