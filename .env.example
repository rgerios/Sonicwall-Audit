# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional bootstrap administrator credentials for unattended Linux startup.
# Leave empty to configure the initial login directly through the web interface.
# SONICAUDIT_ADMIN_USER="admin"
# A senha precisa ter no mínimo 10 caracteres.
# SONICAUDIT_ADMIN_PASS="CHANGE_ME_STRONG_PASSWORD"


# --- Docker Compose -----------------------------------------------------------
# Senha do PostgreSQL (troque o padrão antes de subir em qualquer ambiente real).
# POSTGRES_PASSWORD="CHANGE_ME"
# Usuário inicial via compose (senha com no mínimo 10 caracteres).
# FWAUDIT_ADMIN_USER="admin"
# FWAUDIT_ADMIN_PASS="CHANGE_ME_STRONG_PASSWORD"
# Fuso horário usado nos gráficos e relatórios.
# TZ="America/Sao_Paulo"

# --- Syslog -------------------------------------------------------------------
# Com PostgreSQL todo o histórico fica no banco, limitado só pela retenção em dias
# de cada firewall. Esta é apenas a janela recente mantida em memória por firewall
# para alertas, rankings e IA (padrão: 50000 com PostgreSQL, 20000 sem).
# SYSLOG_MEMORY_WINDOW=50000
# Teto opcional de linhas por firewall para proteger o disco (0 = sem teto).
# SYSLOG_MAX_ROWS_PER_SITE=0
# Defina "false" para não iniciar o receptor UDP automaticamente.
# SYSLOG_UDP_AUTOSTART=true

# --- PostgreSQL em disco mecânico / muitos logs (opcionais) ---------------------
# Memória do banco; ajuste à RAM do servidor (padrões: 256MB e 1GB).
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=2GB

# Tempo máximo de uma busca na tela de Syslogs, em milissegundos (padrão 20000, mínimo 1000).
# SYSLOG_SEARCH_TIMEOUT_MS=20000

# --- HTTPS (painel) ----------------------------------------------------------------
# O painel é servido SOMENTE em HTTPS (certificado local gerado no primeiro start); não há porta HTTP.
# Porta HTTPS publicada (padrão 443). Mude só se a 443 já estiver em uso neste servidor.
# FRONTEND_HTTPS_PORT=443
# Nomes e IPs que o certificado deve cobrir, separados por vírgula (o deploy.sh preenche o IP do servidor).
# TLS_HOSTNAMES=fw-analizer.local
# TLS_IPS=192.168.1.50

# --- Ambiente (PRD x HML) -------------------------------------------------------
# O deploy.sh preenche isto. Em HML: CONTAINER_PREFIX=fwaudit-hml e COMPOSE_PROJECT_NAME=fwaudit-hml
# (containers, volumes e rede separados da produção). Veja RELEASE.md.
# FWAUDIT_ENV=prd
# CONTAINER_PREFIX=fwaudit
