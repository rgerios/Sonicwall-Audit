# Este arquivo é um template do nginx: o entrypoint da imagem substitui ${HTTPS_PUBLIC_PORT}
# (as variáveis do próprio nginx, como $host, não são tocadas) e grava em conf.d/default.conf.

# --- HTTP (porta 80): só redireciona para HTTPS -----------------------------------------------------
server {
  listen 80;
  server_name _;

  # Verificação de saúde do container e download da CA pública (sem aviso de certificado)
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /fwaudit-ca.crt {
    alias /etc/nginx/certs/ca.crt;
    default_type application/x-x509-ca-cert;
    add_header Content-Disposition 'attachment; filename="fwaudit-ca.crt"' always;
    add_header Cache-Control "no-store" always;
  }

  location / {
    return 301 https://$host:${HTTPS_PUBLIC_PORT}$request_uri;
  }
}

# --- HTTPS (porta 443 do container) -----------------------------------------------------------------
server {
  listen 443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/server.crt;
  ssl_certificate_key /etc/nginx/certs/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 60m;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "same-origin" always;

  root /usr/share/nginx/html;
  index index.html;

  # CA pública para importar no navegador (também disponível por HTTP na porta 80)
  location = /fwaudit-ca.crt {
    alias /etc/nginx/certs/ca.crt;
    default_type application/x-x509-ca-cert;
    add_header Content-Disposition 'attachment; filename="fwaudit-ca.crt"' always;
    add_header Cache-Control "no-store" always;
  }

  # Vite hashed static assets
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Autenticação única compartilhada
  location /api/auth/ {
    proxy_pass http://backend-sonicwall:3000/api/auth/;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
  }

  location = /api/health {
    proxy_pass http://backend-sonicwall:3000/api/health;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
  }

  # Ambiente SonicWall (container backend-sonicwall)
  location /api/sonicwall/ {
    proxy_pass http://backend-sonicwall:3000/api/sonicwall/;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # Ambiente FortiGate (container backend-fortigate)
  location /api/fortigate/ {
    proxy_pass http://backend-fortigate:3001/api/fortigate/;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
